{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ops action manifest v0.1",
  "type": "object",
  "required": ["schemaVersion", "action", "summary", "incident", "preconditions", "steps", "postconditions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"},
    "summary": {"type": "string", "minLength": 8},
    "incident": {"type": "string", "minLength": 10, "description": "这条动作是从哪次事故/需求来的"},
    "params": {"type": "object"},
    "preconditions": {"type": "array", "items": {"$ref": "#/definitions/step"}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/step"}},
    "postconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/step"}},
    "rollback": {"type": "array", "items": {"$ref": "#/definitions/step"}}
  },
  "definitions": {
    "step": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"type": "string"}},
      "additionalProperties": true
    }
  }
}
