#!/usr/bin/env bash
# dc —— doublecheck 的命令行入口
#
#   dc list                     列出动作
#   dc plan <action> [k=v ...]  预检
#   dc call <action> [k=v ...] [--yes]
#   dc verify <action> [k=v ...]
#   dc evidence [N]             看最近的本地证据
#   dc ios check --fast|--build|--release   按时机跑 iOS 域检查
#   dc extract                  从 worklog 的 incident/fix 提炼候选动作
#   dc contribute <file.yaml>   提交一个动作到本地收件箱（有 DASH_URL 时同时上传）
#   dc sync                     把本地证据上报（需要 DASH_URL）
#
# 环境变量：
#   DASH_URL   中央服务地址，例如 https://api.ruska.cn
#   DC_HOME    默认 ~/.doublecheck
set -uo pipefail
# 解析符号链接：通过 node_modules/.bin/dc 调用时，BASH_SOURCE 指向软链而非真实文件
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in /*) SELF="$TARGET" ;; *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET" ;; esac
done
HERE="$(cd "$(dirname "$SELF")" && pwd)"
DC_HOME="${DC_HOME:-$HOME/.doublecheck}"
EVIDENCE="$DC_HOME/evidence.jsonl"
INBOX="$DC_HOME/inbox"
DASH_URL="${DASH_URL:-$(python3 "$HERE/tools/dash-url.py" 2>/dev/null)}"

mkdir -p "$DC_HOME" "$INBOX"

case "${1:-}" in
  list|plan)
    exec python3 "$HERE/ops.py" "$@"
    ;;
  call|verify)
    # 执行/复检后，把结果同时写进 worklog 的 journal（同一份审计链）
    out=$(python3 "$HERE/ops.py" "$@" 2>&1); rc=$?
    printf '%s\n' "$out"
    if [ -n "$DASH_URL" ]; then
      # 上报事件（后台、失败不影响主流程）：谁在什么动作上，成功还是失败
      # 同步上报但限时 3 秒：后台子进程在 ssh 退出时可能被回收，导致统计丢数
      python3 "$HERE/tools/report-event.py" "$1" "$2" "$rc" "$DASH_URL" "${DC_AGENT_ID:-anonymous}" >/dev/null 2>&1 || true
    fi
    if [ "${DC_JOURNAL:-1}" = "1" ] && [ -d "${WORKLOG:-/root/worklog}" ]; then
      python3 - "$1" "$2" "$rc" <<'PY2' || true
import json, os, sys, datetime
cmd, action, rc = sys.argv[1], sys.argv[2], sys.argv[3]
wl = os.environ.get("WORKLOG", "/root/worklog")
day = datetime.datetime.now().strftime("%Y-%m-%d")
os.makedirs(os.path.join(wl, day), exist_ok=True)
row = {
    "at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
    "kind": "action",
    "scope": "cross-session",
    "summary": "doublecheck %s %s → %s" % (cmd, action, "成功" if rc == "0" else "失败"),
    "author": {"id": os.environ.get("DC_AGENT_ID", "aliyun:web"), "agent": "web", "node": "aliyun",
               "sessionId": os.environ.get("DSH_SESSION_ID", ""), "profile": os.environ.get("DSH_PROFILE", "")},
    "detail": "由 dc %s 触发；结果码 %s；证据同时写入 ~/.doublecheck/evidence.jsonl" % (cmd, rc),
}
with open(os.path.join(wl, day, "journal.jsonl"), "a", encoding="utf-8") as f:
    f.write(json.dumps(row, ensure_ascii=False) + "\n")
PY2
    fi
    exit $rc
    ;;
  ios)
    shift
    exec python3 "$HERE/tools/ios-check.py" "$@"
    ;;
  extract)
    exec python3 "$HERE/tools/extract-from-worklog.py"
    ;;
  evidence)
    n="${2:-10}"
    if [ ! -f "$EVIDENCE" ]; then echo "（还没有证据）"; exit 0; fi
    tail -n "$n" "$EVIDENCE"
    ;;
  contribute)
    f="${2:?用法: dc contribute <file.yaml>}"
    [ -f "$f" ] || { echo "找不到 $f"; exit 2; }
    cp "$f" "$INBOX/$(basename "$f")"
    echo "已放入本地收件箱: $INBOX/$(basename "$f")"
    if [ -n "$DASH_URL" ]; then
      code=$(curl -sS -m 10 -o /dev/null -w '%{http_code}' -X POST \
        -H 'content-type: application/x-yaml' --data-binary "@$f" "$DASH_URL/v1/submissions" 2>/dev/null)
      echo "上传: HTTP ${code:-失败}"
    else
      echo "（未配置 DASH_URL，仅本地留存；下次 sync 时可一并上报）"
    fi
    ;;
  sync)
    if [ -z "$DASH_URL" ]; then echo "需要 DASH_URL"; exit 2; fi
    Q="$DC_HOME/events-queue.jsonl"
    python3 "$HERE/tools/sync-events.py" "$DASH_URL" "$Q" || true
    if [ ! -s "$EVIDENCE" ]; then echo "没有待上报的证据"; exit 0; fi
    code=$(curl -sS -m 20 -o /dev/null -w '%{http_code}' -X POST \
      -H 'content-type: application/x-ndjson' --data-binary "@$EVIDENCE" \
      "$DASH_URL/v1/evidence" 2>/dev/null)
    if [ "$code" = "200" ] || [ "$code" = "204" ]; then
      mv "$EVIDENCE" "$EVIDENCE.sent-$(date +%s)"
      echo "上报成功（HTTP $code），本地队列已归档"
    else
      echo "上报失败：HTTP ${code:-无响应}，证据保留在本地"
      exit 1
    fi
    ;;
  *)
    sed -n '2,20p' "${BASH_SOURCE[0]}"
    exit 2
    ;;
esac
